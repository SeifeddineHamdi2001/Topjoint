# PostgreSQL connection — matches docker-compose.yml (`npm run db:up`).
# For an existing server: postgresql://USER:PASSWORD@HOST:PORT/topjoint?schema=public
DATABASE_URL="postgresql://topjoint:topjoint@localhost:5434/topjoint?schema=public"
# Admin login for /admin (prefer ADMIN_PASSWORD_HASH generated via scrypt over plaintext ADMIN_PASSWORD)
ADMIN_EMAIL="admin@topjoint.tn"
ADMIN_PASSWORD="change-me"
# ADMIN_PASSWORD_HASH="<saltHex>:<scryptHashHex>"
# Long random string used to sign the admin session cookie
AUTH_SECRET="replace-with-a-long-random-string"
# Optional dedicated 32+ char key for encrypting secrets at rest in DB (defaults to HKDF-derived AUTH_SECRET)
# SETTINGS_ENCRYPTION_KEY="replace-with-a-different-long-random-string"

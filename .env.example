# Public canonical site URL (used for metadata, OpenGraph, sitemap.xml, robots.txt, llms.txt)
SITE_URL="https://topjoint.shop"

# PostgreSQL connection for local development (matches docker-compose.yml `npm run db:up`).
# Note: docker-compose.prod.yml builds DATABASE_URL automatically from POSTGRES_USER/PASSWORD/DB below.
DATABASE_URL="postgresql://topjoint:topjoint@localhost:5434/topjoint?schema=public"

# Production PostgreSQL container credentials (docker-compose.prod.yml)
# Use alphanumeric/hex characters (`openssl rand -hex 24`) to avoid URL-encoding issues in DATABASE_URL.
POSTGRES_USER="topjoint"
POSTGRES_PASSWORD="replace-with-strong-postgres-password"
POSTGRES_DB="topjoint"

# Admin login for /admin (prefer ADMIN_PASSWORD_HASH generated via scrypt over plaintext ADMIN_PASSWORD)
# Generate hash with Node:
#   node -e "const c=require('crypto'),s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync('YOUR_STRONG_PASSWORD',s,64).toString('hex'))"
ADMIN_EMAIL="admin@topjoint.shop"
ADMIN_PASSWORD="change-me"
# ADMIN_PASSWORD_HASH="<saltHex>:<scryptHashHex>"

# Long random strings (32+ chars; generate with `openssl rand -hex 32`)
AUTH_SECRET="9e7df1479476a0942156ffa152ec9de1c54af1cadf39c11f2f883649061ccc6e"
SETTINGS_ENCRYPTION_KEY="replace-with-a-different-long-random-string"

# Note: In /admin/reglages, ensure `metaTestEventCode` is left blank in production.
